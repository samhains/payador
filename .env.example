# PAYADOR example .env
# Copy this file to `.env` and fill in your keys.

# Choose provider: gemini (default) or openrouter
LLM_PROVIDER=gemini

# Gemini setup
# Prefer GOOGLE_API_KEY; GEMINI_API_KEY is also supported
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# OpenRouter setup (optional alternative)
# Uncomment to use OpenRouter instead of Gemini
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.5-pro

# Notes:
# - Values can be quoted or unquoted; loader strips quotes and whitespace.
# - Keep this file out of version control after copying to `.env`.
