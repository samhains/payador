{
  // Start from a blank slate or an example: "blank", "1", or "2"
  "world": "blank",

  // Single-file world bible used to derive system prompt, player persona, starting scenario, and initial world
  "context_path": "context.txt",

  // Enable exploratory world-building so the world can grow via structured updates
  "explore": true,

  // Enable the autonomous player-agent by default (or pass --auto)
  "auto": true,

  // Save/load evolving world state across runs
  "world_state_path": "world_state.json",
  "autosave": true,
  // Avoid loading saved state when starting from blank (fresh context-based bootstrap)
  "skip_load_on_blank": true,
  // Run bootstrap step on start when using blank + context
  "bootstrap_on_start": true
}
